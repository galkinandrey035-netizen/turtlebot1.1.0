{
  "schemaVersion": 1,
  "id": "turtlebot",
  "version": "${version}",
  "name": "TurtleBot",
  "description": "Клиентский бот: кормит взрослых черепах морской травой из сундука.",
  "authors": ["TurtleBot"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["ru.turtlebot.TurtleBotClient"],
    "modmenu": ["ru.turtlebot.gui.ModMenuIntegration"]
  },
  "mixins": ["turtlebot.mixins.json"],
  "jars": [
    { "file": "META-INF/jars/baritone-api-fabric-1.13.1.jar" }
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
